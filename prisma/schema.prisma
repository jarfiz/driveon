generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ADMIN
  USER
  HOST
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  DISPUTED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  DIGITAL_WALLET
}

enum ReviewType {
  HOST
  GUEST
  VEHICLE
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum InsuranceType {
  BASIC
  PREMIUM
  PLATINUM
}

// ============================================================================
// AUTHENTICATION MODELS
// ============================================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  phone         String?
  role          UserRole @default(USER)

  // Profile
  bio           String?
  dateOfBirth   DateTime?
  licenseNumber String?
  licenseExpiry DateTime?

  // Host info
  isHost       Boolean   @default(false)
  hostRating   Float     @default(0)
  hostReviews  Int       @default(0)
  hostJoinedAt DateTime?

  // Guest info
  guestRating  Float @default(0)
  guestReviews Int   @default(0)

  // Account status
  isActive    Boolean @default(true)
  isSuspended Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions Session[]
  accounts Account[]

  // Host listings
  vehicles Vehicle[]

  // Guest bookings
  bookingAsGuest Booking[] @relation("guest")

  // Host side (bookings of host's vehicles)
  bookingAsHost Booking[] @relation("host")

  // Reviews
  reviewsReceived Review[] @relation("reviewed")
  reviewsGiven    Review[] @relation("reviewer")

  // Messages
  sentMessages     Message[]      @relation("sender")
  receivedMessages Message[]      @relation("receiver")
  conversations    Conversation[] @relation("participant")

  // Payments
  payments Payment[]

  // Wallet
  wallet Wallet?

  // Support
  supportTickets SupportTicket[]
  listings       Listing[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

// ============================================================================
// VEHICLE & LISTING MODELS
// ============================================================================

model Vehicle {
  id String @id @default(cuid())

  // Basic info
  brand        String
  model        String
  year         Int
  licensePlate String @unique
  color        String
  transmission String // Manual, Automatic
  fuelType     String // Petrol, Diesel, Electric, Hybrid
  mileage      Int    @default(0)

  // Details
  description String?
  features    String[] // Air conditioning, GPS, WiFi, etc.
  images      String[] // Array of image URLs

  // Status
  status VehicleStatus @default(ACTIVE)

  // Host
  hostId String
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // Rental
  listing  Listing?
  bookings Booking[]

  // Reviews
  reviews Review[]

  // Insurance
  insurances Insurance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId])
  @@index([status])
  @@map("vehicle")
}

model Listing {
  id String @id @default(cuid())

  // Pricing
  pricePerDay    Decimal @db.Decimal(10, 2)
  depositAmount  Decimal @db.Decimal(10, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(10, 2)

  // Availability
  minRentalDays Int  @default(1)
  maxRentalDays Int?

  // Rules
  allowInstantBooking Boolean @default(true)
  requireApproval     Boolean @default(false)
  allowPets           Boolean @default(false)
  allowSmoking        Boolean @default(false)

  // Status
  isActive Boolean @default(true)

  // Vehicle
  vehicleId String  @unique
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  // Host
  hostId String
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId])
  @@index([isActive])
  @@map("listing")
}

// ============================================================================
// BOOKING & PAYMENT MODELS
// ============================================================================

model Booking {
  id String @id @default(cuid())

  // References
  bookingNumber String @unique

  // Status
  status BookingStatus @default(PENDING)

  // Dates
  startDate  DateTime
  endDate    DateTime
  rentalDays Int

  // Pricing
  dailyRate      Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)
  depositAmount  Decimal @db.Decimal(10, 2)
  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  totalPrice     Decimal @db.Decimal(10, 2)

  // Details
  pickupLocation  String
  dropoffLocation String?
  specialRequests String?

  // Parties
  guestId String
  guest   User   @relation("guest", fields: [guestId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  hostId String
  host   User   @relation("host", fields: [hostId], references: [id], onDelete: Restrict)

  // Payment
  payment Payment?

  // Insurance
  insuranceSelected Insurance[]

  // Cancellation
  cancelledAt        DateTime?
  cancellationReason String?
  cancellationRefund Decimal?  @db.Decimal(10, 2)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guestId, vehicleId, startDate, endDate])
  @@index([guestId])
  @@index([hostId])
  @@index([vehicleId])
  @@index([status])
  @@index([startDate])
  @@map("booking")
}

model Payment {
  id String @id @default(cuid())

  // Reference
  paymentIntentId String? @unique
  receiptNumber   String  @unique

  // Amount
  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("USD")

  // Status
  status PaymentStatus @default(PENDING)
  method PaymentMethod @default(CARD)

  // Card details (encrypted)
  last4       String?
  brand       String?
  expiryMonth Int?
  expiryYear  Int?

  // Booking
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Refund
  refundAmount Decimal?  @db.Decimal(10, 2)
  refundReason String?
  refundedAt   DateTime?

  // Metadata
  metadata      String? // JSON string for additional data
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([bookingId])
  @@map("payment")
}

// ============================================================================
// REVIEW & RATING MODELS
// ============================================================================

model Review {
  id String @id @default(cuid())

  // Content
  title   String
  comment String
  rating  Int // 1-5
  type    ReviewType

  // Relations
  reviewerId String
  reviewer   User   @relation("reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  reviewedId String
  reviewed   User   @relation("reviewed", fields: [reviewedId], references: [id], onDelete: Cascade)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  bookingId String?

  // Visibility
  isPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId])
  @@index([reviewerId])
  @@index([reviewedId])
  @@index([vehicleId])
  @@map("review")
}

// ============================================================================
// INSURANCE MODELS
// ============================================================================

model Insurance {
  id String @id @default(cuid())

  // Type
  type InsuranceType

  // Coverage
  coverageLimit Decimal @db.Decimal(10, 2)
  deductible    Decimal @db.Decimal(10, 2)
  description   String

  // Pricing
  pricePerDay Decimal @db.Decimal(10, 2)

  // Vehicle coverage
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  // Bookings using this insurance
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@map("insurance")
}

// ============================================================================
// MESSAGING MODELS
// ============================================================================

model Conversation {
  id String @id @default(cuid())

  // Participants
  participantIds String[]
  participants   User[]   @relation("participant")

  // Last message info
  lastMessage   String?
  lastMessageAt DateTime?

  // Booking context (optional)
  bookingId String?

  // Messages
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantIds])
  @@map("conversation")
}

model Message {
  id String @id @default(cuid())

  // Content
  content String

  // Attachment
  attachmentUrl  String?
  attachmentType String?

  // Status
  status MessageStatus @default(SENT)

  // Sender
  senderId String
  sender   User   @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)

  // Receiver
  receiverId String
  receiver   User   @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  // Conversation
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Read status
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
  @@index([conversationId])
  @@map("message")
}

// ============================================================================
// WALLET & FINANCIAL MODELS
// ============================================================================

model Wallet {
  id String @id @default(cuid())

  // Balance
  balance Decimal @default(0) @db.Decimal(10, 2)

  // User
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallet")
}

model Transaction {
  id String @id @default(cuid())

  // Amount
  amount Decimal @db.Decimal(10, 2)
  type   String // CREDIT, DEBIT

  // Description
  description String
  referenceId String?

  // User
  userId String

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("transaction")
}

// ============================================================================
// SUPPORT & HELP MODELS
// ============================================================================

model SupportTicket {
  id String @id @default(cuid())

  // Content
  subject     String
  description String
  status      String @default("OPEN")
  priority    String @default("NORMAL")

  // Category
  category String

  // User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Resolution
  resolution String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("support_ticket")
}
